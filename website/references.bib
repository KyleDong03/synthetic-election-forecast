% usual convention for software citations.

% Python language itself (requires-python = ">=3.12,<3.13")
@misc{python,
  author       = {{Python Software Foundation}},
  title        = {{Python}},
  version      = {3.12},
  year         = {2023},
  howpublished = {\url{https://www.python.org}},
  note         = {Python Software Foundation, version 3.12}
}

